# Local development
PORT=3001
WEB_ORIGIN=http://localhost:5173

# Gemini (backend only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Channel3 product discovery (backend only)
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=
CHANNEL3_TIMEOUT_MS=12000

# Server-enforced purchase policy (amounts are in the configured currency)
RELAY_POLICY_CURRENCY=USD
RELAY_POLICY_MAX_TRANSACTION_AMOUNT=4000
RELAY_POLICY_MAX_ITEM_PRICE=4000
RELAY_POLICY_MAX_QUANTITY=1
RELAY_POLICY_ALLOWED_CATEGORIES=
RELAY_POLICY_BLOCKED_CATEGORIES=
RELAY_POLICY_ALLOWED_MERCHANTS=
RELAY_POLICY_BLOCKED_MERCHANTS=

# PayPal Sandbox (backend only)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT_MS=12000
