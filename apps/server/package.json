{
  "name": "@relay/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude ../../packages/shared/dist/** src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@channel3/sdk": "^4.8.0",
    "@google/genai": "^1.30.0",
    "@relay/shared": "*",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2"
  }
}
